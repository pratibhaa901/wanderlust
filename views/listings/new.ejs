<% layout("/listings/layouts/boilerplate.ejs");%>
    
    <div class="row">
        <div class="col-8 offset-2">
      
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <h3>Create New Listing</h3>

        <div class="mb-3">
            <label for="title"class="form-label"
            >Title</label>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>
             <div class="valid-feedback">
      Looks good!
    </div>
        </div>
       
      

<div class="mb-3">
    <label for="description"class="form-label">Description</label>
    <textarea name="listing[description]"  class="form-control
    "required></textarea>
     <div class="invalid-feedback">
      please write description
    </div>
</div>
       
<!--  
<div class="mb-3">
    <label for="image"class="form-label">image link</label>
           <input name="listing[image][url]" placeholder="enter image" type="text" class="form-control">

           <input type="hidden" name="listing[image][filename]" value="listingimage">
    
</div> -->

<div class="mb-3">
    <label for="image"class="form-label">Upload Listing Image</label>
           <input name="listing[image][url]" type="file" class="form-control"required>

           <input type="hidden" name="listing[image][filename]" value="listingimage">
    
</div>
       <div class="row">
       <div class="mb-3 col-4">
            <label for="price"class="form-label">price</label>
            <input name="listing[price]" placeholder="enter price" type="text" class="form-control"required>
             <div class="invalid-feedback">please enter valid price</div>
        </div>
         <div class="mb-3 col-8">
    <label for="country"class="form-label">country</label>
            <input name="listing[country]" placeholder="enter country" type="text"class="form-control"required>
             <div class="invalid-feedback">country name required</div>
 </div>
 </div>
       
        <div class="mb-3">
            <label for="location"class="form-label">location</label>
            <input name="listing[location]" placeholder="enter location" type="text" class="form-control"required>
             <div class="invalid-feedback">loaction required</div>
        </div>
         

      
 
     <button class="btn btn-dark add-btn">add</button>


    </form>
    </div>
    </div>
